{
  "manifest_version": 3,
  "name": "NoSky",
  "version": "1.0",
  "description": "Log in to Discord using Tokens, and save or manage them easily",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://discord.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "icons": {
    "128": "logo.png"
  }
}